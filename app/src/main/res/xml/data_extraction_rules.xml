<!--
    Backup and transfer rules for Android 12 (API 31) and above.
    For API 30 and lower, the rules from backup_scheme.xml apply.
-->

<data-extraction-rules>
    <cloud-backup>
        <include
            domain="database"
            path="my_db" />
        <include domain="sharedpref" />
    </cloud-backup>

    <device-transfer>
        <include
            domain="database"
            path="my_db" />
        <include domain="sharedpref" />
    </device-transfer>
</data-extraction-rules>
