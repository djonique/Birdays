<!--
    Material 3 color roles and consolidated semantic tokens - dark scheme.
-->
<resources>
    <!-- Primary: raspberry -->
    <color name="md_theme_primary">#FFB1C8</color>
    <color name="md_theme_on_primary">#65002F</color>
    <color name="md_theme_primary_container">#8E0038</color>
    <color name="md_theme_on_primary_container">#FFD9E1</color>

    <!-- Secondary: mint -->
    <color name="md_theme_secondary">#6FF7DD</color>
    <color name="md_theme_on_secondary">#003731</color>
    <color name="md_theme_secondary_container">#005046</color>
    <color name="md_theme_on_secondary_container">#8CF8DF</color>

    <!-- Neutrals -->
    <color name="md_theme_surface">#1E191A</color>
    <color name="md_theme_on_surface">#EFE0E1</color>
    <color name="md_theme_surface_variant">#524346</color>
    <color name="md_theme_on_surface_variant">#D7C1C5</color>
    <color name="md_theme_outline">#9F8C8F</color>
    <color name="md_theme_outline_variant">#524346</color>
    <color name="md_theme_background">#161213</color>
    <color name="md_theme_on_background">#EFE0E1</color>

    <!-- Error -->
    <color name="md_theme_error">#FFB4AB</color>
    <color name="md_theme_on_error">#690005</color>
    <color name="md_theme_error_container">#93000A</color>
    <color name="md_theme_on_error_container">#FFDAD6</color>

    <!-- State layer (20% of onSurface) -->
    <color name="md_theme_ripple">#33EFE0E1</color>

    <!-- Dark-scheme overrides for consolidated semantic tokens -->
    <color name="app_bar">@color/md_theme_surface</color>
    <color name="on_app_bar">@color/md_theme_on_surface</color>

    <!-- Tabs -->
    <color name="tab_color_main">@color/on_app_bar</color>
    <color name="tab_text_disabled">#CCEFE0E1</color>

    <!-- Text -->
    <color name="primary_text">@color/md_theme_on_surface</color>
    <color name="secondary_text">@color/md_theme_on_surface_variant</color>
    <color name="color_accent">@color/md_theme_secondary</color>

    <!-- Controls -->
    <color name="button_background">@color/md_theme_primary</color>
    <color name="button_text">@color/md_theme_on_primary</color>
    <color name="fab_background">@color/md_theme_secondary</color>
    <color name="fab_icon">@color/md_theme_on_secondary</color>
    <color name="ripple">@color/md_theme_ripple</color>

    <!-- Containers -->
    <color name="cardview_background">@color/md_theme_surface</color>
    <color name="cardview_birthday">@color/md_theme_primary_container</color>
    <color name="divider_color">@color/md_theme_outline_variant</color>

    <!-- Legacy / Decorative aliases -->
    <color name="blue_to_green">@color/md_theme_primary</color>
    <color name="accent_green">#8CF8DF</color>
    <color name="red_alert">#FFB4AB</color>
</resources>
