<!--
    Material 3 color roles and consolidated semantic tokens - light scheme.
-->
<resources>
    <!-- Primary: raspberry -->
    <color name="md_theme_primary">#C2185B</color>
    <color name="md_theme_on_primary">#FFFFFF</color>
    <color name="md_theme_primary_container">#FFD9E1</color>
    <color name="md_theme_on_primary_container">#3F001D</color>

    <!-- Secondary: teal / mint -->
    <color name="md_theme_secondary">#00695C</color>
    <color name="md_theme_on_secondary">#FFFFFF</color>
    <color name="md_theme_secondary_container">#8CF8DF</color>
    <color name="md_theme_on_secondary_container">#00201B</color>

    <!-- Neutrals -->
    <color name="md_theme_surface">#FFFBFF</color>
    <color name="md_theme_on_surface">#201A1B</color>
    <color name="md_theme_surface_variant">#F5DDE2</color>
    <color name="md_theme_on_surface_variant">#524346</color>
    <color name="md_theme_outline">#857376</color>
    <color name="md_theme_outline_variant">#D7C1C5</color>
    <color name="md_theme_background">#FFF6F8</color>
    <color name="md_theme_on_background">#201A1B</color>

    <!-- Error -->
    <color name="md_theme_error">#BA1A1A</color>
    <color name="md_theme_on_error">#FFFFFF</color>
    <color name="md_theme_error_container">#FFDAD6</color>
    <color name="md_theme_on_error_container">#410002</color>

    <!-- State layer (12% of onSurface) -->
    <color name="md_theme_ripple">#1F201A1B</color>

    <!-- Consolidated Semantic Tokens -->
    <color name="app_bar">@color/md_theme_primary</color>
    <color name="on_app_bar">@color/md_theme_on_primary</color>

    <!-- Tabs -->
    <color name="tab_color_main">@color/on_app_bar</color>
    <color name="tab_text_disabled">#CCFFFFFF</color>

    <!-- Text -->
    <color name="primary_text">@color/md_theme_on_surface</color>
    <color name="secondary_text">@color/md_theme_on_surface_variant</color>
    <color name="color_accent">@color/md_theme_secondary</color>

    <!-- Controls -->
    <color name="button_background">@color/md_theme_primary</color>
    <color name="button_text">@color/md_theme_on_primary</color>
    <color name="fab_background">@color/md_theme_secondary_container</color>
    <color name="fab_icon">@color/md_theme_on_secondary_container</color>
    <color name="ripple">@color/md_theme_ripple</color>

    <!-- Containers -->
    <color name="cardview_background">@color/md_theme_surface</color>
    <color name="cardview_birthday">@color/md_theme_primary_container</color>
    <color name="divider_color">@color/md_theme_outline_variant</color>

    <!-- Widget -->
    <color name="widget_header_color">#8CF8DF</color>
    <color name="widget_birthday_color">#FFB4AB</color>
</resources>
