    <!-- HelpActivity -->
    <string name="help_header">Hvorfor virker påmindelsen ikke?</string>
    <string name="help_description">Android-enheder har en strømsparetilstand, der blokerer appen i at køre i baggrunden eller forhindrer den i at starte automatisk. For at få notifikationer til at virke korrekt skal du følge disse enkle trin:\n\n1. Sørg for, at notifikationer er tilladte for Birdays-appen (Indstillinger &gt; Apps &gt; Birdays).\n\n2. Hvis du har opgaveadministratorer, hukommelsesrensnings- eller strømspareapps installeret (f.eks. “Battery Saver”, “Clean Master” og lignende apps), der blokerer baggrundskørsel, skal du tilføje Birdays til undtagelserne.\n\n3. Slå strømsparetilstand fra for Birdays (Indstillinger &gt; Batteri &gt; Batterioptimering).</string>
    <string name="help_settings">Åbn indstillinger</string>
    <string name="help_delay_text">Bemærk, at notifikationer kan blive forsinkede på nogle enheder.</string>
