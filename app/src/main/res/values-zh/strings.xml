    <!-- HelpActivity -->
    <string name="help_header">为什么提醒不起作用？</string>
    <string name="help_description">Android 设备有省电模式，会阻止应用在后台运行或阻止其自动启动。要让通知正常工作，请按以下简单步骤操作：\n\n1. 确保已允许 Birdays 应用发送通知（设置 > 应用 > Birdays）。\n\n2. 如果你安装了会阻止后台运行的任务管理器、内存清理或省电应用（例如“Battery Saver”、“Clean Master”及类似应用），请将 Birdays 加入例外列表。\n\n3. 为 Birdays 关闭省电模式（设置 > 电池 > 电池优化）。</string>
    <string name="help_settings">打开设置</string>
    <string name="help_delay_text">请注意，在某些设备上，通知可能会有所延迟。</string>
