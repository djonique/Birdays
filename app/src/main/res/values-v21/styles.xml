<resources>

    <style name="BirdaysTheme" parent="Theme.AppCompat.DayNight.DarkActionBar">
        <item name="colorPrimary">@color/color_primary</item>
        <item name="colorPrimaryDark">@color/color_primary_dark</item>
        <item name="colorAccent">@color/color_accent</item>
        <item name="colorControlHighlight">@color/ripple</item>
        <item name="android:windowDrawsSystemBarBackgrounds">false</item>
    </style>

    <style name="Material.Primary.TextView" parent="Primary.TextView">
        <item name="android:layout_marginLeft">@dimen/default_left_margin_56sp</item>
        <item name="android:layout_marginStart">@dimen/default_left_margin_56sp</item>
    </style>

    <style name="EditActivity.Primary.TextView" parent="Material.Primary.TextView">
        <item name="android:layout_marginLeft">@dimen/edit_textview_left_padding</item>
        <item name="android:layout_marginStart">@dimen/edit_textview_left_padding</item>
    </style>

    <style name="Material.Secondary.TextView" parent="Secondary.TextView">
        <item name="android:layout_marginLeft">@dimen/default_left_margin_56sp</item>
        <item name="android:layout_marginStart">@dimen/default_left_margin_56sp</item>
    </style>

    <style name="EditActivity.Secondary.TextView" parent="Material.Secondary.TextView">
        <item name="android:layout_marginLeft">@dimen/edit_textview_left_padding</item>
        <item name="android:layout_marginStart">@dimen/edit_textview_left_padding</item>
    </style>

    <style name="detailActivityIcons">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingLeft">@dimen/detail_activity_icon_padding</item>
        <item name="android:paddingStart">@dimen/detail_activity_icon_padding</item>
        <item name="android:paddingTop">@dimen/detail_activity_icon_padding</item>
    </style>
</resources>