<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/default_padding">

        <TextView
            style="@style/Licenses.Primary.TextView"
            android:paddingBottom="@dimen/default_padding"
            android:text="@string/butter_knife_by_jake_wharton" />

        <TextView
            style="@style/Licenses.Secondary.TextView"
            android:text="@string/butter_knife_copyright" />

        <TextView
            style="@style/Licenses.Secondary.TextView"
            android:text="@string/apache_license" />

        <TextView
            style="@style/Licenses.Primary.TextView"
            android:paddingBottom="@dimen/default_padding"
            android:paddingTop="@dimen/default_padding"
            android:text="@string/mdtp_by_wouter_dullaert" />

        <TextView
            style="@style/Licenses.Secondary.TextView"
            android:text="@string/mdtp_copyright" />

        <TextView
            style="@style/Licenses.Secondary.TextView"
            android:text="@string/apache_license" />

        <TextView
            style="@style/Licenses.Primary.TextView"
            android:paddingBottom="@dimen/default_padding"
            android:paddingTop="@dimen/default_padding"
            android:text="@string/rta_by_keisuke_kobayashi" />

        <TextView
            style="@style/Licenses.Secondary.TextView"
            android:text="@string/rta_copyright" />

        <TextView
            style="@style/Licenses.Secondary.TextView"
            android:text="@string/apache_license" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>