<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginLeft="@dimen/default_left_margin_72sp"
        android:layout_marginStart="@dimen/default_left_margin_72sp"
        android:background="@color/divider_color" />

    <TextView
        android:id="@+id/textview_separator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/default_left_margin_56sp"
        android:layout_marginStart="@dimen/default_left_margin_56sp"
        android:fontFamily="sans-serif-medium"
        android:padding="@dimen/default_padding"
        android:textColor="@color/blue_to_green"
        android:textSize="@dimen/separator_text" />
</RelativeLayout>