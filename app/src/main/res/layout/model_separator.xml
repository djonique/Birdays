<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <View
        android:id="@+id/view_separator_line"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="@dimen/default_left_margin_72dp"
        android:background="@color/divider_color" />

    <TextView
        android:id="@+id/textview_separator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/default_left_margin_56dp"
        android:padding="@dimen/default_padding"
        android:textAppearance="@style/TextAppearance.Birdays.TitleMedium"
        android:textColor="@color/color_accent" />
</RelativeLayout>
