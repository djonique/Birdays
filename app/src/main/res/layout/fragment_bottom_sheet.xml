<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal">

    <!-- Facebook -->
    <ImageView
        android:id="@+id/sync_fb"
        style="@style/BottomSheetIcons"
        app:srcCompat="@drawable/ic_facebook_24dp" />

    <!-- vk.com -->
    <ImageView
        android:id="@+id/sync_vk"
        style="@style/BottomSheetIcons"
        app:srcCompat="@drawable/ic_vk_com_24dp" />

    <!-- ok.ru -->
    <ImageView
        android:id="@+id/sync_ok"
        style="@style/BottomSheetIcons"
        app:srcCompat="@drawable/ic_ok_ru_24dp" />
</LinearLayout>