<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/addfromcontacts_button_bottom_margin"
    android:orientation="horizontal">

    <ImageView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:tint="@color/blue_to_green"
        android:contentDescription="@string/add_from_contacts"
        app:srcCompat="@drawable/ic_contacts_blue_24dp" />

    <Button
        android:id="@+id/button_dialog_afc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginStart="16dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:gravity="center"
        android:text="@string/add_from_contacts"
        android:textColor="@color/blue_to_green"
        android:textSize="@dimen/dialog_button_text_size" />
</LinearLayout>