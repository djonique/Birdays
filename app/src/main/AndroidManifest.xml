<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:installLocation="internalOnly">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <!-- Contributed by the ads SDK; the app never uses the Privacy Sandbox attribution APIs. -->
    <uses-permission
        android:name="android.permission.ACCESS_ADSERVICES_ATTRIBUTION"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.ACCESS_ADSERVICES_AD_ID"
        tools:node="remove" />

    <queries>
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="smsto" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="sms" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="mailto" />
        </intent>
        <intent>
            <action android:name="android.intent.action.DIAL" />
            <data android:scheme="tel" />
        </intent>
    </queries>

    <application
        android:name=".utils.BirdaysApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:fullBackupContent="@xml/backup_scheme"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/BirdaysTheme"
        tools:ignore="GoogleAppIndexingWarning">

        <!-- Firebase Cloud Messaging icon -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_notification" />

        <!-- MainActivity -->
        <activity
            android:name=".activities.MainActivity"
            android:exported="true"
            android:theme="@style/BirdaysTheme.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- NewPersonActivity -->
        <activity
            android:name=".activities.NewPersonActivity"
            android:exported="false"
            android:label="@string/new_record"
            android:parentActivityName=".activities.MainActivity"
            android:theme="@style/BirdaysTheme.NoActionBar"
            android:windowSoftInputMode="stateHidden|adjustResize" />

        <!-- DetailActivity -->
        <activity
            android:name=".activities.DetailActivity"
            android:exported="false"
            android:label=""
            android:parentActivityName=".activities.MainActivity"
            android:theme="@style/BirdaysTheme.NoActionBar" />

        <!-- EditActivity -->
        <activity
            android:name=".activities.EditActivity"
            android:exported="false"
            android:label="@string/editing_label"
            android:parentActivityName=".activities.DetailActivity"
            android:theme="@style/BirdaysTheme.NoActionBar"
            android:windowSoftInputMode="stateHidden|adjustResize" />

        <!-- SettingsActivity -->
        <activity
            android:name=".activities.SettingsActivity"
            android:exported="false"
            android:label="@string/action_settings"
            android:parentActivityName=".activities.MainActivity"
            android:theme="@style/BirdaysTheme.NoActionBar" />

        <!-- HelpActivity-->
        <activity
            android:name=".activities.HelpActivity"
            android:exported="false"
            android:label="@string/help"
            android:parentActivityName=".activities.SettingsActivity"
            android:theme="@style/BirdaysTheme.NoActionBar" />

        <!-- LicensesActivity -->
        <activity
            android:name=".activities.LicensesActivity"
            android:exported="false"
            android:label="@string/licenses"
            android:parentActivityName=".activities.SettingsActivity"
            android:theme="@style/BirdaysTheme.NoActionBar" />

        <!-- AlarmReceiver -->
        <receiver
            android:name=".alarm.AlarmReceiver"
            android:exported="false" />

        <!-- AlarmSetter -->
        <receiver
            android:name=".alarm.AlarmSetter"
            android:exported="false">
            <intent-filter>
                <!-- Re-arm after device restart -->
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <!-- Re-arm after an app update (nothing else clears the alarms the same way). -->
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <!-- The wall clock or the time zone changed, so every trigger time moved. -->
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <!-- The user granted exact-alarm access: replace the inexact fallbacks. -->
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- WidgetProvider-->
        <receiver
            android:name=".widget.WidgetProvider"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget" />
        </receiver>

        <!-- WidgetService -->
        <service
            android:name=".widget.WidgetService"
            android:exported="false"
            android:permission="android.permission.BIND_REMOTEVIEWS" />
    </application>
</manifest>